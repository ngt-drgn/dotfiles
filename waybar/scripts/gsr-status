#!/bin/sh

STATE_FILE="/tmp/gsr_monitor_state"

if pgrep -f '^gpu-screen-recorder([[:space:]]|$)' >/dev/null; then
    CURRENT_STATE="recording"
    printf '{"text":"■","class":"recording","tooltip":"GPU Screen Recorder: Recording"}\n'
else
    CURRENT_STATE="stopped"
    printf '{"text":"","class":"stopped","tooltip":""}\n'
fi

if [ -f "$STATE_FILE" ]; then
    PREV_STATE=$(cat "$STATE_FILE")
else
    PREV_STATE="stopped"
fi

if [ "$CURRENT_STATE" != "$PREV_STATE" ]; then
    if [ "$CURRENT_STATE" = "recording" ]; then
        # Start:
        paplay /usr/share/sounds/freedesktop/stereo/audio-volume-change.oga >/dev/null 2>&1 &
    else
        # End:
        paplay /usr/share/sounds/freedesktop/stereo/dialog-information.oga >/dev/null 2>&1 &
    fi
    
    echo "$CURRENT_STATE" > "$STATE_FILE"
fi
