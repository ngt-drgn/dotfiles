# --- Applications ------------------------------------------------------------

# Flameshot needs the theme env inline: sway's `exec` does not inherit the
# variables pushed via dbus-update-activation-environment in autostart.
$bind Mod1+Shift+a exec env GTK_THEME=adw-gtk3-dark QT_QPA_PLATFORMTHEME=qt6ct QT_QPA_PLATFORM=wayland QT_WAYLAND_FORCE_DPI=85 flameshot gui

$bind Mod4+Shift+l exec "/home/drgn/000. AppImages/Logseq.AppImage"
$bind Mod4+Shift+o exec flatpak run md.obsidian.Obsidian
$bind $mod+Shift+s exec flatpak run org.b3log.siyuan
# $bind $mod+Shift+b exec helium
$bind $mod+Shift+b exec flatpak run com.brave.Browser
# $bind Mod4+Shift+b exec flatpak run app.zen_browser.zen
# $bind Mod4+Shift+b exec flatpak run io.gitlab.librewolf-community
# $bind Mod4+Shift+f exec cosmic-files

$bind $mod+v exec $term --app-id=clipboard fsel --cclip -t
$bind Mod4+b        exec ~/.config/sway/cycle-power-profile.sh
$bind Mod4+Escape   exec swaylock

$bind $mod+Shift+d exec $term --app-id=music-tui $SHELL -c "drift; exec $SHELL"

# --- Mouse: resize & split ---------------------------------------------------

$bind --whole-window Mod4+button4        resize grow width 25 px
$bind --whole-window Mod4+button5        resize shrink width 25 px
$bind --whole-window Mod4+Shift+button4  resize grow height 25 px
$bind --whole-window Mod4+Shift+button5  resize shrink height 25 px

$bind --whole-window $mod+button8 splitv
$bind --whole-window $mod+button9 splith

# --- Sway session ------------------------------------------------------------

$bind $mod+Shift+Return exec $term
$bind $mod+Return exec $term --app-id=floating-terminal
$bind $mod+Shift+f exec $term --app-id=yazi -e $SHELL -c "yazi; exec $SHELL"
$bind $mod+Shift+p exec $term --app-id=pi-llm $SHELL -c "pi; exec $SHELL"
# $bind $mod+space exec foot --app-id=fsel-launcher sh -c '$HOME/.cargo/bin/fsel --systemd-run'
$bind $mod+Shift+q kill
$bind $mod+space exec $menu
$bind $mod+Shift+c reload
$bind $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'loginctl terminate-user $(id -un)'

floating_modifier $mod normal

# --- Focus -------------------------------------------------------------------

$bind $mod+$left focus left
$bind $mod+$down focus down
$bind $mod+$up focus up
$bind $mod+$right focus right

$bind $mod+Left focus left
$bind $mod+Down focus down
$bind $mod+Up focus up
$bind $mod+Right focus right

# --- Move windows ------------------------------------------------------------

$bind $mod+Shift+Left move left
$bind $mod+Shift+Down move down
$bind $mod+Shift+Up move up
$bind $mod+Shift+Right move right

# --- Workspaces: focus -------------------------------------------------------

$bind Mod4+Control+Left workspace prev
$bind Mod4+Control+Right workspace next
$bind Mod4+Control+h workspace prev
$bind Mod4+Control+l workspace next

# --- Workspaces: switch ------------------------------------------------------

$bind $mod+1 workspace number 1
$bind $mod+2 workspace number 2
$bind $mod+3 workspace number 3
$bind $mod+4 workspace number 4
$bind $mod+5 workspace number 5
$bind $mod+6 workspace number 6
$bind $mod+7 workspace number 7
$bind $mod+8 workspace number 8
$bind $mod+9 workspace number 9
$bind $mod+0 workspace number 10

# --- Workspaces: move container ----------------------------------------------

$bind $mod+Shift+1 move container to workspace number 1
$bind $mod+Shift+2 move container to workspace number 2
$bind $mod+Shift+3 move container to workspace number 3
$bind $mod+Shift+4 move container to workspace number 4
$bind $mod+Shift+5 move container to workspace number 5
$bind $mod+Shift+6 move container to workspace number 6
$bind $mod+Shift+7 move container to workspace number 7
$bind $mod+Shift+8 move container to workspace number 8
$bind $mod+Shift+9 move container to workspace number 9
$bind $mod+Shift+0 move container to workspace number 10

# --- Layouts -----------------------------------------------------------------

$bind $mod+z splith
$bind $mod+x splitv

$bind $mod+s layout stacking
$bind $mod+w layout tabbed
$bind $mod+e layout toggle split

$bind $mod+f fullscreen
$bind $mod+Shift+space floating toggle
$bind $mod+a focus parent

# --- Scratchpad --------------------------------------------------------------

$bind $mod+Shift+minus move scratchpad
$bind $mod+minus scratchpad show

# --- Resize mode -------------------------------------------------------------

mode "resize" {
    $bind $left resize shrink width 10px
    $bind $down resize grow height 10px
    $bind $up resize shrink height 10px
    $bind $right resize grow width 10px

    $bind Left resize shrink width 10px
    $bind Down resize grow height 10px
    $bind Up resize shrink height 10px
    $bind Right resize grow width 10px

    $bind Return mode "default"
    $bind Escape mode "default"
}
$bind $mod+r mode "resize"

# --- Volume & brightness (swayosd) -------------------------------------------

$bind --locked Mod4+Shift+Delete exec swayosd-client --output-volume mute-toggle
$bind --locked Mod4+Shift+Prior exec swayosd-client --output-volume +5 --max-volume 200
$bind --locked Mod4+Shift+Next  exec swayosd-client --output-volume -5 --max-volume 200

$bind --no-warn --locked XF86AudioMute         exec swayosd-client --output-volume mute-toggle
$bind --no-warn --locked XF86AudioLowerVolume  exec swayosd-client --output-volume -5 --max-volume 200
$bind --no-warn --locked XF86AudioRaiseVolume  exec swayosd-client --output-volume +5 --max-volume 200
$bind --no-warn --locked XF86AudioMicMute      exec sh -c 'swayosd-client --input-volume mute-toggle && pkill -SIGRTMIN+8 waybar'
$bind --locked       Mod4+Shift+End            exec sh -c 'swayosd-client --input-volume mute-toggle && pkill -SIGRTMIN+8 waybar'

$bind --locked XF86MonBrightnessDown exec swayosd-client --brightness -5
$bind --locked XF86MonBrightnessUp   exec swayosd-client --brightness +5

# --- Input -------------------------------------------------------------------

input type:keyboard {
    xkb_layout "us, ua"
    xkb_options "grp:shifts_toggle"
}

input "1267:12734:ELAN06FA:00_04F3:31BE_Touchpad" {
    tap enabled
    drag enabled
    drag_lock disabled
    natural_scroll enabled
    dwt enabled
    click_method clickfinger
    accel_profile adaptive
    pointer_accel 0.5
}

# --- Touchpad gestures -------------------------------------------------------

bindgesture swipe:4:right  workspace prev
bindgesture swipe:4:left   workspace next

bindgesture swipe:3:up     fullscreen toggle
bindgesture swipe:3:down   fullscreen disable

bindgesture pinch:inward   floating enable
bindgesture pinch:outward  floating disable
