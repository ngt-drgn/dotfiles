# --- Variables ---------------------------------------------------------------

set $mod Mod4

set $left  h
set $down  j
set $up    k
set $right l

set $bind bindsym --to-code

set $term foot
set $menu foot --app-id=fsel-launcher fsel -d

# --- Includes ----------------------------------------------------------------

include ~/.config/sway/autostart
include ~/.config/sway/theming
include ~/.config/sway/keybinds
include ~/.config/sway/window-rules

include /etc/sway/config.d/*
