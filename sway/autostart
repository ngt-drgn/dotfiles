# --- Session environment -----------------------------------------------------
# Pushes vars into the D-Bus/systemd activation environment. Note: this does
# NOT propagate to sway's direct `exec` children (see flameshot keybinding).

exec --no-startup-id dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK XDG_RUNTIME_DIR \
    GTK_THEME=adw-gtk3-dark ICON_THEME=qt6ct \
    QT_QPA_PLATFORMTHEME=qt6ct QT_WAYLAND_FORCE_DPI=85
exec_always cclipd -s 2 -t "image/png" -t "image/*" -t "text/plain;charset=utf-8" -t "text/*" -t "*"

# --- Core services -----------------------------------------------------------

exec_always --no-startup-id "killall -q waybar; waybar"
exec --no-startup-id cosmic-settings-daemon
exec --no-startup-id swayosd-server
# exec_always wl-paste --watch ~/.local/bin/clipboard-path-resolver

# --- Applications ------------------------------------------------------------

exec --no-startup-id flatpak run com.dec05eba.gpu_screen_recorder gsr-ui
# exec_always flatpak run org.localsend.localsend_app
# exec --no-startup-id walker --gapplication-service
exec protonvpn-app

# --- Clipboard history -------------------------------------------------------

exec --no-startup-id wl-paste --watch cliphist store

# --- Idle, lock & power ------------------------------------------------------

exec --no-startup-id swayidle -w \
    before-sleep 'swaylock -f -c 000000'

bindswitch --locked lid:on exec systemctl suspend
