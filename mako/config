# --- Catppuccin Mocha Configuration for Mako (Squared) ---

# Typography & Layout
font=sans-serif 10
width=320
height=110
margin=10
padding=12
border-size=2
border-radius=0
anchor=top-right

# Icons
icons=1
max-icon-size=48
icon-location=left

# Default Colors (Mocha Base & Text)
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244

# Notification Behavior
default-timeout=5000
ignore-timeout=0

# --- Urgency Overrides ---

[urgency=low]
background-color=#1e1e2e
text-color=#a6adc8
border-color=#89b4fa

[urgency=normal]
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa

[urgency=critical]
background-color=#1e1e2e
text-color=#f38ba8
border-color=#f38ba8
default-timeout=0
