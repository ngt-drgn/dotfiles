{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
    "source": "~/Pictures/.theming/logo.txt"
  },
  "display": {
    "separator": "   ",
    "color": {
      "keys": "blue",
      "title": "cyan",
      "separator": "black"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "{3}"
    },
    "kernel",
    "uptime",
    "shell",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "separator",
    "colors",
    "break",
    {
      "type": "command",
      "key": " ",
      "text": "cat ~/.config/fastfetch/logo.txt",
      "splitLines": true
    }
  ]
}
